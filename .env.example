# Copy to .env and fill in. .env is git-ignored. Synthetic data only — the PII proxy
# sends tokenised payloads, never raw personal data, to any provider.

# Real models in one step: with this set, SETU uses Groq (openai/gpt-oss-20b, escalating
# to openai/gpt-oss-120b on a measured trigger). Leave empty to use the offline simulator.
GROQ_API_KEY=

# Optional: force a profile (sim | sim_alt | groq | openai_compatible).
# SETU_MODEL_PROFILE=
